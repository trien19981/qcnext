# Gọi FastAPI trực tiếp (cookie refresh trên origin API — cần CORS credentials)
# NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8002

# Hoặc để trống: browser gọi cùng origin Next, proxy rewrite tới API (cookie refresh trên :3000)
# NEXT_PUBLIC_API_BASE_URL=

# Target FastAPI cho rewrite /api/v1/* (server-side)
API_UPSTREAM_URL=http://127.0.0.1:8002
